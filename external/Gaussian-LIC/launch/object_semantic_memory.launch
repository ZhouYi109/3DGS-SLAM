<?xml version="1.0"?>
<launch>
  <arg name="sam2_config" />
  <arg name="sam2_checkpoint" />
  <arg name="clip_model" default="ViT-B/32" />
  <arg name="clip_download_root" default="/root/autodl-fs/models/clip_checkpoints" />
  <arg name="image_topic" default="/image_for_gs" />
  <arg name="depth_topic" default="/depth_for_gs" />
  <arg name="pose_topic" default="/pose_for_gs" />
  <arg name="object_grid_topic" default="/semantic_feature_grid" />
  <arg name="object_latent_delta_topic" default="/semantic_object_latent_delta" />
  <arg name="object_latent_dim" default="16" />
  <arg name="object_latent_weights" default="" />
  <arg name="semantic_pending_topic" default="/semantic_pending_frame" />
  <arg name="semantic_compute_grant_topic" default="/semantic_compute_grant" />
  <arg name="output_prefix" default="$(find gaussian_lic)/result/object_memory/object_memory" />
  <arg name="device" default="cuda" />
  <arg name="cpu_threads" default="4" />
  <arg name="max_fps" default="0.5" />
  <arg name="scheduling_mode" default="independent" />
  <arg name="deferred_queue_size" default="32" />
  <arg name="sam2_points_per_side" default="16" />
  <arg name="max_instances" default="16" />
  <arg name="grid_rows" default="16" />
  <arg name="grid_cols" default="20" />
  <arg name="sam2_amp_dtype" default="off" />
  <arg name="warmup_iterations" default="1" />

  <node
      pkg="gaussian_lic"
      type="object_semantic_memory_node.py"
      name="object_semantic_memory"
      output="screen"
      args="--sam2-config $(arg sam2_config)
            --sam2-checkpoint $(arg sam2_checkpoint)
            --clip-model $(arg clip_model)
            --clip-download-root $(arg clip_download_root)
            --image-topic $(arg image_topic)
            --depth-topic $(arg depth_topic)
            --pose-topic $(arg pose_topic)
            --object-grid-topic $(arg object_grid_topic)
            --object-latent-delta-topic $(arg object_latent_delta_topic)
            --object-latent-dim $(arg object_latent_dim)
            --object-latent-weights $(arg object_latent_weights)
            --semantic-pending-topic $(arg semantic_pending_topic)
            --semantic-compute-grant-topic $(arg semantic_compute_grant_topic)
            --output-prefix $(arg output_prefix)
            --device $(arg device)
            --cpu-threads $(arg cpu_threads)
            --max-fps $(arg max_fps)
            --scheduling-mode $(arg scheduling_mode)
            --deferred-queue-size $(arg deferred_queue_size)
            --sam2-amp-dtype $(arg sam2_amp_dtype)
            --warmup-iterations $(arg warmup_iterations)
            --sam2-points-per-side $(arg sam2_points_per_side)
            --max-instances $(arg max_instances)
            --grid-rows $(arg grid_rows)
            --grid-cols $(arg grid_cols)" />
</launch>
